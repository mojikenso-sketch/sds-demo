/**
 * DEMO setup, sample data, automatic reset and locked premium features.
 *
 * Owner (run once from the Apps Script editor):
 *   setupDemo()     creates/reuses the Google Sheet + Drive folder, writes the
 *                   sample data, sets the demo password and installs ONE
 *                   hourly trigger for demoAutoReset().
 *   resetDemoNow()  re-seeds immediately (manual reset).
 *
 * Trigger:
 *   demoAutoReset() runs every hour; it re-seeds once DEMO_RESET_HOURS have
 *   passed since DEMO_LAST_RESET (DEMO_RESET_TOLERANCE_MS absorbs a trigger
 *   that fires a few seconds early).
 *
 * Premium features (PDF upload, delete, table / hazard settings) are locked in
 * the public demo: the web page shows a 🔒 message and doPost() rejects the
 * matching API actions with DEMO_LOCKED_MESSAGE (see demoLockedReason_).
 *
 * The sample records live in DemoSeed.gs (generated by tools/build-demo-seed.js;
 * the GitHub Pages site embeds the same data in docs/demo-seed.js).
 */

var DEMO_LAST_RESET_PROPERTY = "DEMO_LAST_RESET";
// Shared demo data is re-seeded every DEMO_RESET_HOURS hours.
var DEMO_RESET_HOURS = 5;
var DEMO_RESET_HANDLER = "demoAutoReset";
// demoAutoReset() is called by an hourly time-based trigger.
var DEMO_TRIGGER_EVERY_HOURS = 1;
// A reset is due when MORE than DEMO_RESET_HOURS minus this tolerance has
// passed (so 4 h 59 min exactly is not due, 4 h 59 min 30 s is).
var DEMO_RESET_TOLERANCE_MS = 60 * 1000;

// Premium features of the full version that the public demo keeps locked.
// Set to false only for local tests / a private full demo.
var DEMO_PREMIUM_LOCKED = true;
var DEMO_LOCKED_MESSAGE = "ฟีเจอร์นี้มีในเวอร์ชันเต็ม";
// doPost actions that are always locked (delete, shared table / hazard settings).
var DEMO_LOCKED_ACTIONS = ["delete", "saveColumnWidths", "saveColumnVisibility", "saveHazardDefinitions"];
// Public demo password for edit / delete / table settings (shown on the page).
var DEMO_ACTION_PASSWORD = "demo1234";
var DEMO_SPREADSHEET_NAME = "SDS Demo Database (Demo Co., Ltd.)";
var DEMO_FOLDER_NAME = "SDS Demo - uploaded PDF";

var DEMO_DEFAULT_HAZARD_DEFINITIONS = [
  { id: "health-hazard", name: "pictogram-4.png", image: "assets/pictograms/pictogram-4.png", className: "pictogram-health" },
  { id: "corrosive", name: "pictogram-5.png", image: "assets/pictograms/pictogram-5.png", className: "pictogram-corrosive" },
  { id: "environmental-hazard", name: "pictogram-6.png", image: "assets/pictograms/pictogram-6.png", className: "pictogram-environment" },
  { id: "flammable", name: "pictogram-7.png", image: "assets/pictograms/pictogram-7.png", className: "pictogram-flammable" },
  { id: "irritant", name: "pictogram-8.png", image: "assets/pictograms/pictogram-8.png", className: "pictogram-irritant" },
  { id: "acute-toxicity", name: "pictogram-9.png", image: "assets/pictograms/pictogram-9.png", className: "pictogram-toxic" },
  { id: "exploding-bomb", name: "pictogram-10.png", image: "assets/pictograms/pictogram-10.png", className: "pictogram-explosive" },
  { id: "gas-cylinder", name: "pictogram-11.png", image: "assets/pictograms/pictogram-11.png", className: "pictogram-gas" },
  { id: "oxidizer", name: "pictogram-12.png", image: "assets/pictograms/pictogram-12.png", className: "pictogram-oxidizer" }
];

/**
 * One-time setup for the owner. Safe to run again: reuses the existing
 * Sheet/folder, re-seeds, and keeps exactly one demoAutoReset trigger.
 */
function setupDemo() {
  var properties = PropertiesService.getScriptProperties();
  var spreadsheet = ensureDemoSpreadsheet_();
  var folder = ensureDemoFolder_();
  properties.setProperties({
    SDS_SPREADSHEET_ID: spreadsheet.getId(),
    SDS_FOLDER_ID: folder.getId(),
    SDS_ACTION_PASSWORD: DEMO_ACTION_PASSWORD,
    // Only the owner account counts as administrator. Anonymous visitors of
    // the public web app always use the demo password instead.
    ADMIN_EMAILS: Session.getEffectiveUser().getEmail() || ""
  });

  var seeded = seedDemoData_();
  var trigger = installDemoResetTrigger_();
  var result = {
    spreadsheetUrl: spreadsheet.getUrl(),
    folderUrl: folder.getUrl(),
    records: seeded.records,
    demoPassword: DEMO_ACTION_PASSWORD,
    trigger: trigger,
    demo: getDemoInfo_()
  };
  console.log("setupDemo: " + JSON.stringify(result));
  return result;
}

/** Manual reset (run from the editor). */
function resetDemoNow() {
  var result = seedDemoData_();
  console.log("resetDemoNow: " + JSON.stringify(result));
  return result;
}

/** Hourly trigger target: re-seeds once DEMO_RESET_HOURS have passed. */
function demoAutoReset() {
  var props = PropertiesService.getScriptProperties();
  var last = props.getProperty(DEMO_LAST_RESET_PROPERTY);
  if (!isDemoResetDue_(last, new Date())) {
    var due = nextDemoResetTime_(last);
    console.log("demoAutoReset: not due yet (last " + last + ", next " + due.toISOString() + ")");
    return { reset: false, lastReset: last, nextReset: due.toISOString() };
  }
  var result = seedDemoData_();
  result.reset = true;
  console.log("demoAutoReset: data reset " + JSON.stringify(result));
  return result;
}

/** True when no reset happened yet or DEMO_RESET_HOURS have passed. */
function isDemoResetDue_(lastResetIso, now) {
  var last = Date.parse(String(lastResetIso || ""));
  if (!isFinite(last)) return true;
  var elapsed = (now || new Date()).getTime() - last;
  return elapsed > DEMO_RESET_HOURS * 60 * 60 * 1000 - DEMO_RESET_TOLERANCE_MS;
}

/**
 * Reason why a doPost payload is refused in the public demo, or "" when it is
 * allowed. Browsing, search, adding a new SDS record (text only) and editing
 * stay available; PDF upload, delete and shared settings are premium.
 */
function demoLockedReason_(payload) {
  if (!DEMO_PREMIUM_LOCKED || !payload) return "";
  if (DEMO_LOCKED_ACTIONS.indexOf(String(payload.action || "")) !== -1) return DEMO_LOCKED_MESSAGE;
  if (payload.action === "save" && payload.file && (payload.file.base64 || payload.file.name)) {
    return DEMO_LOCKED_MESSAGE + " (อัปโหลด PDF)";
  }
  return "";
}

/**
 * Wipes the SDS sheet, trashes every PDF uploaded to the demo folder, writes
 * the sample records with dates relative to today and restores the shared
 * settings (column widths / headings / pictograms) and the demo password.
 */
function seedDemoData_() {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  var now = new Date();
  var trashedFiles = 0;
  var rows;
  try {
    var sheet = getSheet_();
    var lastRow = sheet.getLastRow();
    if (lastRow > 1) {
      sheet.getRange(2, 1, lastRow - 1, Math.max(sheet.getMaxColumns(), SDS_HEADERS.length)).clearContent();
    }

    // Uploaded PDFs belong to visitors of the demo: remove them all.
    var files = getFolder_().getFiles();
    while (files.hasNext()) {
      var file = files.next();
      try {
        file.setTrashed(true);
        trashedFiles += 1;
      } catch (error) {
        console.warn("Could not trash demo file: " + error.message);
      }
    }

    rows = demoSeedRows_(now);
    if (rows.length) sheet.getRange(2, 1, rows.length, SDS_HEADERS.length).setValues(rows);

    // Visitors may have locked the (production) password check or changed the
    // shared table layout: restore everything to the defaults.
    try { CacheService.getScriptCache().remove(PASSWORD_FAIL_CACHE_KEY); } catch (ignored) {}
    var values = {};
    values[DEMO_LAST_RESET_PROPERTY] = now.toISOString();
    values[ACTION_PASSWORD_PROPERTY] = DEMO_ACTION_PASSWORD;
    values[COLUMN_WIDTHS_PROPERTY] = JSON.stringify(demoDefaultColumnWidths_());
    values[COLUMN_VISIBILITY_PROPERTY] = JSON.stringify(parseColumnVisibility_(""));
    values[HAZARD_DEFINITIONS_PROPERTY] = JSON.stringify(demoDefaultHazardDefinitions_());
    markDataChanged_(values, true);
  } finally {
    lock.releaseLock();
  }
  refreshBootstrapCache_();
  return {
    records: rows.length,
    trashedFiles: trashedFiles,
    lastReset: now.toISOString(),
    nextReset: nextDemoResetTime_(now.toISOString()).toISOString()
  };
}

/** Sheet rows for DEMO_SEED_RECORDS, in the same column layout as saveSds(). */
function demoSeedRows_(now) {
  var base = now || new Date();
  var day = 24 * 60 * 60 * 1000;
  var timeZone = Session.getScriptTimeZone();
  var dateText = function(offsetDays) {
    return Utilities.formatDate(new Date(base.getTime() + offsetDays * day), timeZone, "yyyy-MM-dd");
  };
  return DEMO_SEED_RECORDS.map(function(seed) {
    var record = JSON.parse(JSON.stringify(seed));
    var revisionDaysAgo = Number(record.revisionDaysAgo) || 0;
    record.revisionDate = dateText(-revisionDaysAgo);
    record.reviewDate = dateText(Number(record.reviewInDays) || 0);
    var normalized = normalizeRecord_(record);
    var updatedAt = new Date(base.getTime() - (Number(record.sequence) % 20) * day).toISOString();
    return [
      normalized.id,
      normalized.chemical,
      normalized.cas,
      normalized.supplier,
      normalized.revision,
      normalized.revisionDate,
      normalized.status,
      normalized.signalWord,
      normalized.hazards.join("|"),
      "",
      clean_(record.pdfName),
      updatedAt,
      normalized.reviewDate,
      normalized.thaiSds,
      normalized.language,
      normalized.flashPoint,
      normalized.emergencyResponse,
      normalized.sdsLanguages.join("|"),
      normalized.chemicalThai,
      normalized.chemicalEnglish,
      "",
      clean_(record.thaiPdfName),
      "",
      clean_(record.englishPdfName),
      clean_(record.pdfUrl),
      clean_(record.thaiPdfUrl),
      clean_(record.englishPdfUrl),
      normalized.composition,
      normalized.ratio,
      normalized.personalProtectiveEquipment.join("|"),
      serializeMeasures_(normalized.firstAidMeasures),
      serializeMeasures_(normalized.firefightingMeasures),
      normalized.sequence,
      normalized.group,
      normalized.responsibleParty,
      normalized.recorder,
      normalized.dateOfUse,
      normalized.registerSds,
      serializeComponents_(normalized.components)
    ];
  });
}

function demoDefaultColumnWidths_() {
  var widths = {};
  Object.keys(COLUMN_WIDTH_LIMITS).forEach(function(index) {
    widths[index] = COLUMN_WIDTH_LIMITS[index].fallback;
  });
  return widths;
}

function demoDefaultHazardDefinitions_() {
  return DEMO_DEFAULT_HAZARD_DEFINITIONS.map(function(item) {
    return { id: item.id, name: item.name, aliases: [], iconId: "", icon: "", image: item.image, className: item.className };
  });
}

/** Last/next reset for the web page (action=demoInfo and inside bootstrap). */
function getDemoInfo_() {
  return demoInfoFrom_(PropertiesService.getScriptProperties().getProperties());
}

function demoInfoFrom_(props) {
  var last = (props && props[DEMO_LAST_RESET_PROPERTY]) || "";
  var next = nextDemoResetTime_(last);
  return {
    isDemo: true,
    lastReset: last,
    nextReset: next ? next.toISOString() : "",
    intervalHours: DEMO_RESET_HOURS,
    triggerEveryHours: DEMO_TRIGGER_EVERY_HOURS,
    premiumLocked: DEMO_PREMIUM_LOCKED,
    timeZone: "Asia/Bangkok"
  };
}

/** lastReset + DEMO_RESET_HOURS. Returns null when no reset happened yet. */
function nextDemoResetTime_(lastResetIso) {
  var last = Date.parse(String(lastResetIso || ""));
  if (!isFinite(last)) return null;
  return new Date(last + DEMO_RESET_HOURS * 60 * 60 * 1000);
}

/** Removes old demoAutoReset triggers and installs exactly one hourly trigger. */
function installDemoResetTrigger_() {
  var removed = 0;
  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (trigger.getHandlerFunction() === DEMO_RESET_HANDLER) {
      ScriptApp.deleteTrigger(trigger);
      removed += 1;
    }
  });
  ScriptApp.newTrigger(DEMO_RESET_HANDLER).timeBased().everyHours(DEMO_TRIGGER_EVERY_HOURS).create();
  return { handler: DEMO_RESET_HANDLER, removed: removed, installed: 1, everyHours: DEMO_TRIGGER_EVERY_HOURS };
}

function ensureDemoSpreadsheet_() {
  var id = PropertiesService.getScriptProperties().getProperty("SDS_SPREADSHEET_ID");
  if (id) {
    try {
      var existing = SpreadsheetApp.openById(id);
      if (existing.getSheetByName("SDS")) return existing;
    } catch (error) {
      console.warn("Demo spreadsheet not found, creating a new one: " + error.message);
    }
  }
  var spreadsheet = SpreadsheetApp.create(DEMO_SPREADSHEET_NAME);
  var sheet = spreadsheet.getSheets()[0];
  sheet.setName("SDS");
  if (sheet.getMaxColumns() < SDS_HEADERS.length) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), SDS_HEADERS.length - sheet.getMaxColumns());
  }
  sheet.getRange(1, 1, 1, SDS_HEADERS.length).setValues([SDS_HEADERS]);
  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 1, SDS_HEADERS.length).setFontWeight("bold");
  return spreadsheet;
}

function ensureDemoFolder_() {
  var id = PropertiesService.getScriptProperties().getProperty("SDS_FOLDER_ID");
  if (id) {
    try {
      var existing = DriveApp.getFolderById(id);
      if (!existing.isTrashed || !existing.isTrashed()) return existing;
    } catch (error) {
      console.warn("Demo folder not found, creating a new one: " + error.message);
    }
  }
  return DriveApp.createFolder(DEMO_FOLDER_NAME);
}

/** True when the Drive file is stored in the demo upload folder. */
function isInDemoFolder_(file) {
  var folderId = PropertiesService.getScriptProperties().getProperty("SDS_FOLDER_ID");
  if (!folderId) return false;
  var parents = file.getParents();
  while (parents.hasNext()) {
    if (parents.next().getId() === folderId) return true;
  }
  return false;
}
